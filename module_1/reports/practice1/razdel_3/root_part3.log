$: cd ~

$: touch "${USER}_part3.log"

$: mkdir -p D1/D2/D3

$: touch D1/D2/file.txt

$: echo "Hello from file.txt" > D1/D2/file.txt

$: cd D1/D2/D3

$: ln -s ../file.txt symbolic_link
$: ln ../file.txt hard_link

$: ls -li ../file.txt symbolic_link hard_link
