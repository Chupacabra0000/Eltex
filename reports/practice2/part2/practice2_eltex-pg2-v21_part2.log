root@eltex-practice2-pg2-v21:~# touch "practice2_${MYUSER}_part2.log"
root@eltex-practice2-pg2-v21:~# BOOT=$(date -d "$(uptime -s)" '+%Y-%m-%d %H:%M:%S')
root@eltex-practice2-pg2-v21:~# END=$(date -d "$BOOT 20 seconds" '+%Y-%m-%d %H:%M:%S')
root@eltex-practice2-pg2-v21:~# journalctl -b --since "$BOOT" --until "$END" > "20_sec_journalctl.log"
root@eltex-practice2-pg2-v21:~# find /var/log -type f -name 'auth.log' 2>/dev/null
/var/log/auth.log
root@eltex-practice2-pg2-v21:~# awk '{source=$3; message=""; for (i=4; i<=NF; i++) message=message (i==4 ? "" : " ") $i; print source, message}' /var/log/auth.log | sed -E 's/\[[0-9]+\]//' | sort -k1,1 > clean_auth.log
root@eltex-practice2-pg2-v21:~# awk '{print $1}' clean_auth.log | sed -E 's/\[[0-9]+\]//' | sort | uniq -c | sort -rn > log_count.log
root@eltex-practice2-pg2-v21:~# cat /etc/passwd |wc -l
38
root@eltex-practice2-pg2-v21:~# awk -F: '$7=="/usr/sbin/nologin" {print $3, $1}' /etc/passwd | sort -rn |wc -l
29
root@eltex-practice2-pg2-v21:~# while IFS=: read -r username password uid gid gecos home shell; do
    if [ "$shell" = "/usr/sbin/nologin" ]; then
        groups_list=$(awk -F: -v u="$username" -v g="$gid" \
            '$3==g || $4 ~ ("(^|,)" u "(,|$)") {print $1}' /etc/group |
            paste -sd, -)
        printf '%s, %s, %s\n' "$uid" "$username" "$groups_list"
    fi
done < /etc/passwd | sort -t, -k1,1nr
